{
  "name": "papelo",
  "version": "0.1.0",
  "private": true,
  "description": "Papelo: recogida de documentación de clientes con recordatorios automáticos para gestorías y despachos.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.ts",
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18"
  }
}
