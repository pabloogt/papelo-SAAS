# Copia este archivo a .env (o define las variables en tu plataforma). En producción todas las marcadas son obligatorias.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Obligatoria en producción, mínimo 32 caracteres. Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
DATABASE_PATH=./data/papelo.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
SCHEDULER_INTERVAL_MIN=15
# Pon 1 sólo detrás de un proxy de confianza (Fly.io, Render…) para leer la IP real del cliente.
TRUST_PROXY=0

# Email transaccional (Resend). Sin clave, los correos se registran y se ven en /dev/mail.
EMAIL_FROM=Papelo <avisos@tudominio.es>
RESEND_API_KEY=

# Stripe (modo test en desarrollo: claves sk_test_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_DESPACHO=
